# ============================================
# kaipy API — variables de entorno (ejemplo)
# Copiar a api/.env no hace falta: el API lee
# estas variables directamente del entorno.
# ============================================

# Puerto del API
PORT=3000

# Origen permitido para CORS ("*" solo para desarrollo)
CORS_ORIGIN=*

# Saltos de proxy de confianza para req.ip real.
# Detras de nginx/caddy en produccion: 1
TRUST_PROXY=0

# --- Filtro NSFW (filtro principal) ---
# 0 desactiva el filtro (solo pruebas); cualquier otro valor = activo
NSFW_ENABLED=1

# Umbral: puntaje nsfw >= umbral => la foto se bloquea (0..1)
NSFW_THRESHOLD=0.5

# Modelo de clasificacion (HuggingFace, requiere ONNX)
NSFW_MODEL=AdamCodd/vit-base-nsfw-detector

# Precision de los pesos ONNX: int8 (rapido) | fp32 (exacto)
NSFW_DTYPE=int8
